# Copy this file to .env and fill in your own key(s).
# See README.md for how to get a key and which Google Cloud APIs to enable.

# Used by the browser (Maps JavaScript API + Places). Restrict this key to
# your HTTP referrer (e.g. http://localhost:3000/*) in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=

# Used server-side (Directions API + Isochrones API). Restrict this key by
# IP address, or leave it unrestricted since it never reaches the browser.
GOOGLE_MAPS_SERVER_KEY=

# Optional: if set, used as a fallback for both of the above when the
# specific key isn't set. Handy for quick local testing with one key.
GOOGLE_MAPS_API_KEY=

# Port the local server listens on.
PORT=3000
